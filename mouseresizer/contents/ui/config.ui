    <widget class="QLabel" name="label_intro">
     <property name="text">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;One rule per line: &lt;span style=&quot; font-weight:700;&quot;&gt;app1,app2,app3:WIDTHxHEIGHT&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Use &lt;span style=&quot; font-weight:700;&quot;&gt;Default:WIDTHxHEIGHT&lt;/span&gt; for windows that don't match any other rule. Remove the Default line to leave unmatched windows untouched.&lt;/p&gt;&lt;p&gt;Example:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;Default:800x600&lt;br/&gt;&lt;br/&gt;firefox,discord,telegram:1200x960&lt;br/&gt;kitty,ghostty,konsole:1100x900&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
